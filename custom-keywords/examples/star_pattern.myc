/* My star pattern module for this compiler project. */
#include <stdio.h>

int main(void) {
    int rows;
    output("How many rows (1 to 20)? ");
    when (input("%d", &rows) != 1 || rows < 1 || rows > 20) {
        output("Enter a number from 1 to 20.\n");
        provide 1;
    }
    each (int i = 1; i <= rows; i++) {
        each (int j = 1; j <= i; j++) {
            output("*");
        }
        output("\n");
    }
    provide 0;
}
